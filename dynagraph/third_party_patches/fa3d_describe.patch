diff -ruN a/hopper/launch_sink.h b/hopper/launch_sink.h
--- a/hopper/launch_sink.h	1970-01-01 00:00:00.000000000 +0000
+++ b/hopper/launch_sink.h	2026-10-05 19:46:56.771371098 +0000
@@ -0,0 +1,62 @@
+#pragma once
+// Describe mode: while `launch_sink` is set on this thread, every launch the
+// forward pass would make is written into it instead of being made. What a
+// CUDA graph needs to hold the launch as a node -- function, grid, block,
+// cluster, dynamic smem, PDL, and the kernel parameter bytes -- and nothing
+// reaches the GPU. Memsets are recorded the same way.
+#include <cuda_runtime.h>
+#include <cstdint>
+#include <cstring>
+#include <stdexcept>
+
+namespace flash {
+
+struct LaunchSink {
+    int64_t* buf;   // buf[0] = number of records, records follow
+    int64_t cap;    // in int64 words
+    int64_t len;
+};
+
+inline thread_local LaunchSink* launch_sink = nullptr;
+
+inline void sink_put(int64_t v) {
+    if (launch_sink->len >= launch_sink->cap) { throw std::runtime_error("launch sink full"); }
+    launch_sink->buf[launch_sink->len++] = v;
+}
+
+// Record: 0, func, grid xyz, block xyz, cluster xyz, smem, pdl, nbytes, bytes...
+template <class Params>
+inline bool sink_kernel(void const* func, dim3 grid, dim3 block, dim3 cluster, int smem, bool pdl,
+                        Params const& params) {
+    if (launch_sink == nullptr) { return false; }
+    cudaFunction_t f;
+    if (cudaGetFuncBySymbol(&f, func) != cudaSuccess) { throw std::runtime_error("cudaGetFuncBySymbol"); }
+    launch_sink->buf[0] += 1;
+    for (int64_t v : {int64_t(0), int64_t(reinterpret_cast<intptr_t>(f)),
+                      int64_t(grid.x), int64_t(grid.y), int64_t(grid.z),
+                      int64_t(block.x), int64_t(block.y), int64_t(block.z),
+                      int64_t(cluster.x), int64_t(cluster.y), int64_t(cluster.z),
+                      int64_t(smem), int64_t(pdl), int64_t(sizeof(Params))}) {
+        sink_put(v);
+    }
+    int64_t words = (int64_t(sizeof(Params)) + 7) / 8;
+    if (launch_sink->len + words > launch_sink->cap) { throw std::runtime_error("launch sink full"); }
+    std::memset(launch_sink->buf + launch_sink->len, 0, words * 8);
+    std::memcpy(launch_sink->buf + launch_sink->len, &params, sizeof(Params));
+    launch_sink->len += words;
+    return true;
+}
+
+// Record: 1, ptr, nbytes (set to zero)
+inline bool sink_memset(void* ptr, int64_t nbytes) {
+    if (launch_sink == nullptr) { return false; }
+    launch_sink->buf[0] += 1;
+    sink_put(1); sink_put(int64_t(reinterpret_cast<intptr_t>(ptr))); sink_put(nbytes);
+    return true;
+}
+
+inline void sink_refuse(char const* what) {
+    if (launch_sink != nullptr) { throw std::runtime_error(what); }
+}
+
+}  // namespace flash
